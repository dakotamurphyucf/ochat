let initial_state = `Empty
let field json name = match Json.get_field(json, name) with
  | `Some(value) -> value | `None -> `Null
let string json = match json with | `String(text) -> text | _ -> ""
let rec find state job = match state with
  | `Empty -> `None
  | `Work(work, rest) -> if work.job == job then `Some(work.invocation) else find(rest, job)
let rec remove state job = match state with
  | `Empty -> `Empty
  | `Work(work, rest) -> if work.job == job then rest else `Work(work, remove(rest, job))
let on_event ctx state event = match event with
  | `Tool_invoked(p) ->
    let* job = Job.start_tool("probe", p.input) in
    let* () = Invocation.resolve(p.context.invocation_id, `Pending(`Job(job), `Object([
      { key = "job_id"; value = `String(job) },
      { key = "status"; value = `String("accepted") }
    ]))) in
    Task.pure(`Work({job = job; invocation = p.context.invocation_id}, state))
  | `Internal_event(payload) ->
    if string(field(payload, "kind")) == "background_job_completed" then
      let job = string(field(payload, "job_id")) in
      (match find(state, job) with
        | `None -> Task.pure(state)
        | `Some(invocation) ->
          let* result = Job.read_result(job) in
          let terminal = match field(result, "type") with
            | `String("succeeded") -> `Succeeded(field(result, "value"))
            | `String("cancelled") -> `Cancelled(string(field(result, "reason")))
            | _ -> `Failed({code = "probe.failed"; message = "Probe did not succeed.";
                retryable = false; details = result})
          in
          let wake = match terminal with | `Succeeded(_) -> `Request_turn | _ -> `No_wake in
          let reference = {key = "probe-result"; invocation_id = `Some(invocation); work = `Some(`Job(job))} in
          let* delivery = Notification.publish(reference, terminal, wake) in
          Task.pure(remove(state, job)))
    else Task.pure(state)
  | _ -> Task.pure(state)
