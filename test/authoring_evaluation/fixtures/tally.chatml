let initial_state = 0.0
let on_event ctx state event = match event with
  | `Tool_invoked(p) ->
    if p.context.tool_name == "tally" then
      let amount = match Json.get_field(p.input, "amount") with
        | `Some(`Number(value)) -> value
        | _ -> fail("expected amount") in
      let total = state +. amount in
      let* () = Invocation.resolve(p.context.invocation_id, `Complete(`Number(total))) in
      Task.pure(total)
    else Task.pure(state)
  | _ -> Task.pure(state)
