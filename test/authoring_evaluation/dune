(library
 (name authoring_evaluation)
 (modules runner tasks driver report execution_audit suite responses_provider responses_http reference_backend execution_host execution_cases moderator_cases background_cases child_cases repair_cases digest_cases)
 (libraries core core_unix jsonaf eio eio_main mirage-crypto-rng.unix cohttp-eio tls-eio ca-certs
  ochat.chat_response ochat.agent_server ochat.agent_client agent_server_test_support)
 (preprocess (pps ppx_jane ppx_jsonaf_conv)))

(library
 (name authoring_evaluation_fixtures)
 (modules solutions offline_transcript)
 (libraries core jsonaf authoring_evaluation)
 (preprocessor_deps (glob_files_rec fixtures/*))
 (preprocess (pps ppx_jane ppx_blob)))

(library
 (name authoring_evaluation_tests)
 (modules runner_tests driver_tests audit_tests provider_tests integration_tests execution_tests moderator_tests background_tests capability_tests child_tests repair_tests)
