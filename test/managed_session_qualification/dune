(executable
 (name main)
 (modules main managed_send authored_pending)
 (libraries agent_server_test_support agent_server_wire_fixture core eio eio_main mirage-crypto-rng.unix ochat.agent_server ochat.agent_client)
 (preprocess (pps ppx_jane)))

(rule
 (alias agent-managed-qualification)
 (targets output.actual)
 ; Target-producing rules are cached even with --force; qualification must run.
 (deps expected.output (universe))
 (action
  (progn
   (with-stdout-to %{targets} (run %{exe:main.exe}))
   (diff expected.output output.actual))))
