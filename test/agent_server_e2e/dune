(executable
 (name agent_server_e2e)
 (modules :standard)
 (libraries
  base64
  core
  core_unix.command_unix
  core_unix.unix_pseudo_terminal
  cstruct
  digestif
  eio
  eio_main
  eio_posix
  eio.unix
  mirage-crypto-rng.unix
  ochat.agent_client
  ochat.agent_protocol
  ochat.agent_server
  ochat.chat_response
  ochat.chat_tui
  ochat.openai
  ochat.agent_transport_http
  ochat.agent_transport_socket
  piaf
  uri)
 (preprocessor_deps
  (glob_files_rec ../chatml_extensibility_fixtures/x08-external-completion/*))
 (preprocess
  (pps ppx_jane ppx_blob)))

(rule
 (alias agent-e2e-tui-auto)
 (deps (alias agent-e2e-typeahead))
 (action
  (setenv OCHAT_E2E_ARTIFACT_ROOT %{workspace_root}/_build/agent-e2e-artifacts
   (setenv OCHAT_E2E_TUI_EXE %{exe:../../bin/chat_tui.exe}
    (setenv OCHAT_E2E_SERVER_EXE %{exe:../../bin/ochat_agent_server.exe}
     (run %{exe:agent_server_e2e.exe} --scenario tui-parity))))))

(rule
 (alias agent-e2e-harness)
 (deps dune)
 (action
  (setenv
   OCHAT_E2E_ARTIFACT_ROOT
   %{workspace_root}/_build/agent-e2e-artifacts
   (progn
    (run %{exe:agent_server_e2e.exe} --scenario harness-isolation)
    (run %{exe:agent_server_e2e.exe} --scenario process-harness)))))

