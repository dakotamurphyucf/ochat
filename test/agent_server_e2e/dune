(rule
 (alias agent-e2e-transports)
 (action
  (setenv
   OCHAT_E2E_ARTIFACT_ROOT
   %{workspace_root}/_build/agent-e2e-artifacts
   (setenv
    OCHAT_E2E_SERVER_EXE
    %{exe:../../bin/ochat_agent_server.exe}
    (setenv
     OCHAT_E2E_STDIO_EXE
     %{exe:../../bin/ochat_agent_stdio.exe}
     (progn
      (run %{exe:agent_server_e2e.exe} --scenario unix-transport)
      (run %{exe:agent_server_e2e.exe} --scenario stdio-modes)
      (run %{exe:agent_server_e2e.exe} --scenario http-transport)
      (run
       %{exe:agent_server_e2e.exe}
       --scenario
       cross-transport-conformance)))))))

