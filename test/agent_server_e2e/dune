(include_subdirs qualified)

(rule
 (alias agent-e2e-typeahead)
 (action
  (setenv OCHAT_E2E_ARTIFACT_ROOT %{workspace_root}/_build/agent-e2e-artifacts
   (setenv OCHAT_E2E_SERVER_EXE %{exe:../../bin/ochat_agent_server.exe}
    (setenv OCHAT_E2E_TUI_EXE %{exe:../../bin/chat_tui.exe}
     (progn
      (run %{exe:agent_server_e2e.exe} --scenario tui-typeahead)
      (run %{exe:agent_server_e2e.exe} --scenario tui-manual --case typeahead-self-check)))))))

(alias
 (name agent-e2e-pr)
 (deps
  (alias agent-e2e-smoke)
  (alias agent-e2e-transports)
  (alias agent-e2e-workspaces)
  (alias agent-e2e-multiclient)))

