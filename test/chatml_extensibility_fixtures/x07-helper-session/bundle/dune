;; A complete directory built from the same source fragments as the offline tests.
(rule
 (target helper-moderator.chatml)
 (deps ../moderator.chatml ../../x06-response-watcher/watcher.chatml ../coordinator-entrypoint.chatml)
 (action
  (with-stdout-to %{target}
   (progn
    (cat ../moderator.chatml)
    (echo "\nlet helper_initial_state = initial_state\nlet helper_on_event = on_event\n")
    (cat ../../x06-response-watcher/watcher.chatml)
    (cat ../coordinator-entrypoint.chatml)))))

(rule (target helper-request.chatml) (action (copy ../request.chatml %{target})))
(rule (target helper-tools.chatmd) (action (copy ../tools.chatmd %{target})))
(rule (target helper-any.json) (action (copy ../any.json %{target})))
(rule (target watch-tools.chatmd) (action (copy ../../x06-response-watcher/tools.chatmd %{target})))
(rule (target watch-probe.chatml) (action (copy ../../x06-response-watcher/probe.chatml %{target})))
(rule (target watch-native.chatml) (action (copy ../../x06-response-watcher/native-request.chatml %{target})))
(rule (target watch-input.json) (action (copy ../../x06-response-watcher/input.json %{target})))

(alias
 (name bundle)
 (deps README.md server.template.sexp agent.chatmd native-watch-agent.chatmd base.chatmd helper-watch.chatmd native-watch.chatmd
  helper-moderator.chatml helper-request.chatml helper-tools.chatmd helper-any.json
  watch-tools.chatmd watch-probe.chatml watch-native.chatml watch-input.json))
