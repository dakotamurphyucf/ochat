(* E05 admits work and publishes its initial acknowledgement. E06 adds the
   correlated notification and coalesced wake after the terminal job commit. *)
let initial_state = 0
let on_event = fun ctx state event -> match event with
| `Tool_invoked(p) ->
    Task.bind(Job.start_tool("fixture_work", `Object([])), fun job ->
      Task.bind(Invocation.resolve(p.context.invocation_id,
        `Pending(`Job(job), `Object([
          { key = "job_id"; value = `String(job) },
          { key = "status"; value = `String("accepted") }
        ]))), fun ignored -> Task.pure(state + 1)))
| _ -> Task.pure(state)
