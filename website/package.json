{
  "name": "ochat-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "content": "node scripts/content.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "npm run content && astro check && node --test tests/*.test.mjs",
    "build": "npm run content && astro build && node scripts/check-output.mjs",
    "preview": "node scripts/preview.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/**/*.{astro,css,ts}\" \"scripts/*.mjs\" \"config/*.mjs\" \"tests/**/*.{mjs,ts}\" astro.config.mjs playwright.config.ts",
    "review:design": "node scripts/review-design.mjs && node scripts/review-keyboard.mjs",
    "evaluate:search": "node scripts/evaluate-search.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "check:semantics": "node scripts/check-semantics.mjs",
    "artifact": "node scripts/release-artifact.mjs",
    "rehearse:static": "node scripts/rehearse-static.mjs",
    "rehearse:hosted": "node scripts/rehearse-hosted.mjs",
    "release:ready": "node scripts/release-approval.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "astro": "7.3.1",
    "chokidar": "5.0.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "11.17.2",
    "pagefind": "1.5.2",
    "parse5": "8.0.1",
    "proper-lockfile": "4.1.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "satori": "0.33.4",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "node": "22.22.1",
    "playwright-core": "1.61.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
