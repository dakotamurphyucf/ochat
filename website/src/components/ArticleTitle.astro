---
import {
  searchWeight,
  searchStatus,
  searchKind,
} from '../../config/search.mjs';
import Default from '@astrojs/starlight/components/PageTitle.astro';
import report from '../../.generated/content-report.json';
import { sourceUrl } from '../../config/site.mjs';
const entry = report.pages.find((e) => e.route === Astro.url.pathname);
---

{
  entry && (
    <p class="section-label" data-pagefind-ignore>
      {entry.section}{' '}
      {entry.status === 'experimental' && <span>Experimental</span>}
      {entry.disposition === 'bridge' && <span>Previous location</span>}
      {entry.sourceModified && <span>Local edits</span>}
    </p>
  )
}
<div
  data-pagefind-weight={searchWeight(entry)}
  data-pagefind-meta="section[data-section], status[data-status], kind[data-kind]"
  data-section={entry?.section}
  data-kind={searchKind(entry)}
  data-status={searchStatus(entry)}
>
  <Default />
</div>
{
  entry && (
    <>
      <>
        <p
          class="article-description"
          data-pagefind-weight={
            entry?.disposition === 'compatibility' ? 0.1 : 4
          }
        >
          {entry.description}
        </p>
        {entry.sourceCommit === null ? (
          <span
            class="source-link"
            data-pagefind-ignore
            data-source-pending={entry.source}
          >
            Source: {entry.source} · new local file, commit pending
          </span>
        ) : (
          <a
            class="source-link"
            data-pagefind-ignore
            href={sourceUrl(entry.source)}
          >
            {entry.sourceModified
              ? 'View committed Markdown source ↗'
              : 'View Markdown source ↗'}
          </a>
        )}
      </>
    </>
  )
}
<style>
  .section-label {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }
  .section-label span {
    display: inline-block;
    white-space: nowrap;
    margin-inline-start: 0.8rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 4px;
  }
  .article-description {
    font-size: 1.13rem;
    line-height: 1.65;
    max-width: 58ch;
    color: var(--sl-color-gray-2);
    margin-top: 1rem;
  }
  .source-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
    margin-top: 1rem;
    text-underline-offset: 0.22em;
    overflow-wrap: anywhere;
  }
</style>
