---
import { origin } from '../../config/site.mjs';
import {
  socialPath,
  socialAlt,
  brandColors,
} from '../../config/presentation.mjs';
interface Props {
  route: string;
  title: string;
  description: string;
  card?: boolean;
}
const { route, title, description, card = true } = Astro.props;
const image = origin + socialPath(route);
---

<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={socialAlt(title)} />
{card && <meta name="twitter:card" content="summary_large_image" />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={socialAlt(title)} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta
  name="theme-color"
  content={brandColors.background}
  media="(prefers-color-scheme: dark)"
/>
<meta
  name="theme-color"
  content={brandColors.lightBackground}
  media="(prefers-color-scheme: light)"
/>
