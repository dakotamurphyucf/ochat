---
import applications from '../../.generated/applications-report.json';
import report from '../../.generated/examples-report.json';
import ExampleSource from './ExampleSource.astro';
import VerificationDetails from './VerificationDetails.astro';
const tutorial = report.tutorials.find((t) => t.route === Astro.url.pathname);
const application = applications.applications.find(
  (a) => a.route === Astro.url.pathname,
);
const examples = application
  ? [report.examples.find((e) => e.id === application.example)!]
  : tutorial
    ? tutorial.examples.map((id) => report.examples.find((e) => e.id === id)!)
    : report.examples.filter(
        (e) => e.tutorialRoute === Astro.url.pathname && e.files.length > 0,
      );
---

{
  tutorial && (
    <aside
      class="tutorial-record"
      data-pagefind-ignore
      aria-label="Tutorial context and verification"
    >
      <p class="lesson">
        {tutorial.id}{' '}
        <span>
          of {report.tutorials.length} · {tutorial.host}
        </span>
      </p>
      <p class="source-links">
        Example catalog:{' '}
        {tutorial.examples.map((id, index) => {
          const example = report.examples.find((e) => e.id === id)!;
          return (
            <>
              {index > 0 && ' · '}
              <a href={`/docs/examples/#example-${id}`}>{example.title}</a>
            </>
          );
        })}
      </p>
      <details data-pagefind-ignore>
        <summary>
          Verification:{' '}
          {tutorial.verification.state === 'offline-checked'
            ? 'checked offline'
            : tutorial.verification.state.replaceAll('-', ' ')}
        </summary>
        <VerificationDetails verification={tutorial.verification} />
      </details>
    </aside>
  )
}
{
  examples.length > 0 && (
    <section class="tutorial-sources" aria-label="Example source files">
      {examples.map((example, index) => (
        <ExampleSource example={example} open={index === 0} />
      ))}
    </section>
  )
}
<style>
  .tutorial-record {
    border: 0;
    border-left: 0;
    border-radius: 6px;
    padding: 0;
    margin: 0 0 2rem;
    background: transparent;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .lesson {
    font-weight: 700;
    color: var(--sl-color-text-accent);
    margin: 0;
  }
  .lesson span {
    font-weight: 400;
    color: var(--sl-color-text);
  }
  .source-links {
    margin: 0.6rem 0;
  }
  a {
    color: var(--sl-color-text-accent);
    text-underline-offset: 0.2em;
  }
  details {
    margin-top: 0.7rem;
    font-size: 0.8rem;
  }
  summary {
    cursor: pointer;
    min-height: 1.8rem;
  }
  details p {
    margin: 0.7rem 0;
  }
  code {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  ul {
    padding-left: 1.2rem;
  }
</style>
