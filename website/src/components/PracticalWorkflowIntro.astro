---
const lessons = [
  {
    reference: '/docs/reference/chatml/programs/',
    href: '/docs/tutorials/chatml-program/',
    title: 'Write a tool-using report program',
    description:
      'Learn the language through file reads, JSON data and deterministic aggregation, then return here for the exact program contract.',
  },
  {
    reference: '/docs/reference/chatml/child-sessions/',
    href: '/docs/guides/subagents/',
    title: 'Choose a delegation pattern',
    description:
      'Compare a one-off specialist, a retained authored conversation and a specialist generated for the task. Follow the decision guide into complete tutorials.',
  },
  {
    reference: '/docs/reference/chatml/chatmd-definitions/',
    href: '/docs/tutorials/generated-specialist/',
    title: 'Create and follow up with a generated specialist',
    description:
      'See a complete definition, documentation discovery, validation and session lifecycle. Generated children select existing delegated capabilities.',
  },
  {
    reference: '/docs/reference/chatml/chatmd-capabilities/',
    href: '/docs/tutorials/shell-guardrails/',
    title: 'Design useful capabilities and guardrails',
    description:
      'Use separate command runtimes and explicit file access in a working project. The reference below explains the exact admission and delegation boundaries.',
  },
  {
    reference: '/docs/reference/chatml/authoring-context/',
    href: '/docs/tutorials/generated-specialist/',
    title: 'Use documentation discovery before creating a specialist',
    description:
      'An agent can query the installed language and runtime documentation instead of guessing unfamiliar ChatML or ChatMD syntax.',
  },
  {
    reference: '/docs/reference/chatml/native-requests/',
    href: '/docs/applications/persistent-review-team/',
    title: 'Follow session requests through a complete review team',
    description:
      'Learn why IDs, receipts, cursors and lifecycle operations matter before using the exact request schemas below.',
  },
  {
    reference: '/docs/reference/chatml/execution-contracts/',
    href: '/docs/tutorials/stateful-workflow/',
    title: 'Build a stateful review ledger',
    description:
      'See invocation resolution and retained moderator state in a complete working example.',
  },
  {
    reference: '/docs/reference/chatml/background-work/',
    href: '/docs/tutorials/background-results/',
    title: 'Run checks and deliver background results',
    description:
      'Follow a real checker from acknowledgement through progress, cancellation and a terminal notification.',
  },
];
const lesson = lessons.find((item) => item.reference === Astro.url.pathname);
---

{
  lesson && (
    <aside
      class="workflow-intro"
      aria-label="Try this workflow"
      data-pagefind-ignore
    >
      <p>
        <strong>Learn through a complete example.</strong> {lesson.description}
      </p>
      <a href={lesson.href}>{lesson.title} →</a>
    </aside>
  )
}

<style>
  .workflow-intro {
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    border-left: 3px solid var(--ochat-accent);
    background: var(--ochat-panel);
    border-radius: 0 var(--ochat-radius-panel) var(--ochat-radius-panel) 0;
    line-height: 1.7;
  }
  p {
    margin: 0 0 0.5rem;
  }
  a {
    color: var(--ochat-accent);
    text-underline-offset: 0.2em;
  }
</style>
