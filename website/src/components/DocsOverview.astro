---
import entries from '../../config/docs-manifest.json';
import { documentationPaths } from '../../config/navigation.mjs';
const paths = documentationPaths(entries);
---

<section class="learning-intro" aria-label="Start learning Ochat">
  <p>
    Build an agent that can inspect your project, run useful tools, and work
    with specialists. Add a script when you want the workflow's decisions in
    code.
  </p>
  <nav aria-label="Learning shortcuts">
    <a href="/docs/start/first-agent/">Run your first agent →</a>
    <a href="/docs/concepts/how-ochat-works/">How the pieces fit together →</a>
    <a href="/docs/tutorials/">Choose a learning path →</a>
  </nav>
</section>
<nav
  class="documentation-paths"
  aria-label="Documentation paths"
  data-pagefind-ignore
>
  {
    paths.map((path) => (
      <a href={path.href}>
        <span class="path-label">{path.label}</span>
        <span class="path-title">
          {path.title}
          <span aria-hidden="true">↗</span>
        </span>
        <span class="path-description">{path.description}</span>
      </a>
    ))
  }
</nav>
<nav class="lookup-paths" aria-label="Applications and reference">
  <a href="/docs/applications/">Explore applications →</a>
  <a href="/docs/examples/">Browse complete source files →</a>
  <a href="/docs/reference/chatmd/">Look up ChatMD declarations →</a>
</nav>
<style>
  .learning-intro {
    margin-bottom: 1.5rem;
  }
  .learning-intro p {
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 65ch;
  }
  .learning-intro nav,
  .lookup-paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .learning-intro a,
  .lookup-paths a {
    display: inline;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ochat-accent);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .lookup-paths {
    margin-bottom: 2rem;
  }
  .documentation-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 40.01rem) {
    .documentation-paths > a:last-child {
      grid-column: 1 / -1;
    }
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--ochat-line);
    border-radius: var(--ochat-radius-panel);
    color: var(--ochat-ink);
    background: var(--ochat-panel);
    text-decoration: none;
  }
  a:hover {
    border-color: var(--ochat-accent);
  }
  a:focus-visible {
    outline: 3px solid var(--ochat-focus);
    outline-offset: 3px;
  }
  .path-label {
    font-family: var(--ochat-mono);
    font-size: 0.7rem;
    color: var(--ochat-muted);
  }
  .path-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 750;
    line-height: 1.4;
  }
  .path-title span {
    flex-shrink: 0;
  }
  .path-description {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--ochat-muted);
  }
  @media (max-width: 40rem) {
    .documentation-paths {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
