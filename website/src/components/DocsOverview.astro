---
import entries from '../../config/docs-manifest.json';
import { documentationPaths } from '../../config/navigation.mjs';
const paths = documentationPaths(entries);
---

<nav
  class="documentation-paths"
  aria-label="Documentation paths"
  data-pagefind-ignore
>
  {
    paths.map((path) => (
      <a href={path.href}>
        <span class="path-label">{path.label}</span>
        <span class="path-title">
          {path.title}
          <span aria-hidden="true">↗</span>
        </span>
        <span class="path-description">{path.description}</span>
      </a>
    ))
  }
</nav>
<style>
  .documentation-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--ochat-line);
    border-radius: var(--ochat-radius-panel);
    color: var(--ochat-ink);
    background: var(--ochat-panel);
    text-decoration: none;
  }
  a:hover {
    border-color: var(--ochat-accent);
  }
  a:focus-visible {
    outline: 3px solid var(--ochat-focus);
    outline-offset: 3px;
  }
  .path-label {
    font-family: var(--ochat-mono);
    font-size: 0.7rem;
    color: var(--ochat-muted);
  }
  .path-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 750;
    line-height: 1.4;
  }
  .path-title span {
    flex-shrink: 0;
  }
  .path-description {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--ochat-muted);
  }
  @media (max-width: 40rem) {
    .documentation-paths {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
