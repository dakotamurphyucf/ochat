---
import report from '../../.generated/examples-report.json';
import ExampleSource from './ExampleSource.astro';
const labels = {
  complete: 'Complete source example',
  template: 'Configurable template',
  illustration: 'Illustrative output',
};
const size = (n: number) =>
  n < 1024 ? `${n} bytes` : `${(n / 1024).toFixed(1)} KB`;
---

<section class="example-catalog" aria-labelledby="source-catalog">
  <div class="catalog-heading">
    <p class="eyebrow">From reading to building</p>
    <h2 id="source-catalog">Source example catalog</h2>
    <p>
      Small starting points, with their files kept together. Choose an example,
      read its source right here, and follow its tutorial to run it locally.
    </p>
  </div>
  <nav class="catalog-jump" aria-label="Example types">
    <a href="#complete-examples">Complete examples</a>
    <a href="#template-examples">Templates</a>
    <a href="#illustration-examples">Output samples</a>
  </nav>
  {
    (['complete', 'template', 'illustration'] as const).map((kind) => (
      <section aria-labelledby={`${kind}-examples`}>
        <h3 id={`${kind}-examples`}>
          {kind === 'complete'
            ? 'Start with a complete example'
            : kind === 'template'
              ? 'Adapt to your environment'
              : 'Learn to read the output'}
        </h3>
        <div class="example-grid">
          {report.examples
            .filter((e) => e.kind === kind)
            .map((e) => (
              <article id={`example-${e.id}`} class="example-card">
                <p class="example-kind">{labels[kind]}</p>
                <h4>{e.title}</h4>
                <p>{e.summary}</p>
                <ul class="capabilities" aria-label="Required capabilities">
                  {e.capabilities.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                <p class="host">
                  <strong>Host:</strong> {e.host}
                </p>
                <ul class="requirements">
                  {e.required.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
                <a class="tutorial-link" href={e.tutorialRoute}>
                  {e.tutorialTitle} <span aria-hidden="true">→</span>
                </a>
                <ExampleSource example={e} />
                {e.bundle && (
                  <a
                    class="bundle-link"
                    href={e.bundle.href}
                    download={e.bundle.filename}
                  >
                    Download {e.title.toLowerCase()} bundle{' '}
                    <span>({size(e.bundle.size)})</span>
                  </a>
                )}
                {e.illustrationUrl && (
                  <a href={e.illustrationUrl}>Read the illustrative source ↗</a>
                )}
                {e.files.length > 0 && (
                  <details class="source-details" data-pagefind-ignore>
                    <summary>Files, source, and verification</summary>
                    <p>
                      Preserve these relative paths. The bundle includes every
                      file below. Source links identify the recorded Git
                      revision; local edits are marked.
                    </p>
                    <ul class="source-files">
                      {e.files.map((f) => (
                        <li>
                          <a href={f.href} download={f.path.split('/').at(-1)}>
                            {f.path}
                          </a>{' '}
                          <span>· {size(f.size)}</span>
                          <br />
                          {f.sourceCommit === null ? (
                            <span>
                              New local source: {f.source} · commit pending
                            </span>
                          ) : (
                            <a href={f.sourceUrl}>
                              {f.sourceModified
                                ? 'Committed source (local edits)'
                                : 'View source'}{' '}
                              ↗
                            </a>
                          )}
                          <code class="hash" title="SHA-256">
                            SHA-256 {f.sha256}
                          </code>
                        </li>
                      ))}
                    </ul>
                    <p>
                      <strong>{e.verification.state}</strong> ·{' '}
                      {e.verification.scope}
                    </p>
                    <p>{e.verification.limitations}</p>
                    <p class="verification-context">
                      {e.verification.testedAt} · {e.verification.platform} ·{' '}
                      {e.verification.toolchain}
                    </p>
                    <p class="verification-context">
                      Base revision <code>{e.verification.baseRevision}</code>;
                      exact source hashes above.{' '}
                      {e.verification.liveProvider
                        ? 'Includes recorded provider work.'
                        : 'No live provider calls.'}
                    </p>
                  </details>
                )}
              </article>
            ))}
        </div>
      </section>
    ))
  }
</section>
<style>
  .example-catalog {
    margin-top: 3rem;
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: 2rem;
  }
  .eyebrow,
  .example-kind {
    color: var(--sl-color-text-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  h2 {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    line-height: 1.2;
    margin: 0.5rem 0 1rem;
  }
  h3 {
    margin: 2rem 0 1rem;
    font-size: 1.2rem;
  }
  h4 {
    font-size: 1.4rem;
    line-height: 1.3;
    margin: 0.55rem 0 0.8rem;
  }
  p {
    margin: 0.7rem 0;
  }
  .catalog-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.3rem;
    margin: 1.4rem 0;
  }
  a {
    color: var(--sl-color-text-accent);
    text-underline-offset: 0.2em;
  }
  h2,
  h3,
  h4 {
    color: var(--sl-color-white);
  }
  .example-grid {
    display: grid;
    align-items: start;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .example-card:has(.example-source[open]) {
    grid-column: 1 / -1;
  }
  .example-card {
    min-width: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--sl-color-bg-sidebar);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  .capabilities {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .capabilities li {
    font-size: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    padding: 0.2rem 0.55rem;
    border-radius: 1rem;
  }
  .requirements {
    padding-left: 1.2rem;
    font-size: 0.85rem;
  }
  .tutorial-link,
  .bundle-link {
    display: block;
    margin: 1rem 0;
    font-weight: 600;
  }
  .bundle-link {
    border: 1px solid var(--sl-color-gray-4);
    padding: 0.65rem 0.8rem;
    border-radius: 6px;
  }
  .bundle-link span {
    font-weight: 400;
    font-size: 0.8rem;
  }
  .source-details {
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 1rem;
    padding-top: 0.8rem;
  }
  summary {
    cursor: pointer;
    min-height: 2rem;
  }
  .source-files {
    list-style: none;
    padding: 0;
  }
  .source-files li {
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding: 0.8rem 0;
  }
  .hash {
    display: block;
    font-size: 0.7rem;
    overflow-wrap: anywhere;
    white-space: normal;
    margin-top: 0.4rem;
  }
  .verification-context {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  @media (max-width: 55rem) {
    .example-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
