---
import WorkflowDemo from '../components/WorkflowDemo.astro';
import WorkflowIcon from '../components/WorkflowIcon.astro';
import applications from '../../.generated/applications-report.json';
import { Code } from 'astro:components';
import SocialHead from '../components/SocialHead.astro';
import { homeTitle, homeDescription } from '../../config/presentation.mjs';
import Search from '../components/Search.astro';
import Mark from '../components/Mark.astro';
import ThemeProvider from '../components/ThemeProvider.astro';
import {
  repository,
  origin,
  production,
  sourceUrl,
} from '../../config/site.mjs';
import hero from '../../.generated/hero.json';
import '../styles/home.css';
const capabilities = applications.applications.filter((a) =>
  ['repository-onboarding', 'research-brief', 'headless-report'].includes(a.id),
);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width"
    />
    <title>{homeTitle}</title>
    <meta name="description" content={homeDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link
      rel="canonical"
      href={origin + '/'}
    />
    {!production && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={homeTitle} /><meta
      property="og:description"
      content={homeDescription}
    /><meta property="og:type" content="website" /><meta
      property="og:url"
      content={origin + '/'}
    />
    <meta property="og:site_name" content="Ochat" />
    <SocialHead route="/" title={homeTitle} description={homeDescription} />
    <ThemeProvider />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Ochat home"
        ><Mark /><span>ochat</span></a
      >
      <nav aria-label="Main navigation">
        <a href="/docs/">Documentation</a><a href="/docs/tutorials/"
          >Tutorials</a
        ><a href="/docs/applications/">Applications</a><a href="/docs/examples/"
          >Examples</a
        >
      </nav>
      <div class="header-actions">
        <Search compact />
        <button
          id="theme-toggle"
          type="button"
          aria-label="Dark color theme"
          aria-pressed="false"
          title="Switch color theme"
          ><svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"
            ><circle
              cx="12"
              cy="12"
              r="4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle><path
              d="M12 1v3m0 16v3M1 12h3m16 0h3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"
              stroke="currentColor"
              stroke-width="1.6"></path></svg
          ></button
        ><a class="github-link" href={repository}
          >GitHub <span aria-hidden="true">↗</span></a
        >
      </div>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot"></span> An open-source framework for agents
          </p>
          <h1 id="hero-title">
            Build agents.<br />Keep control.<br /><span>Just text files.</span>
          </h1>
          <p class="hero-description">
            Understand unfamiliar projects, review changes, research
            documentation, and coordinate specialist agents. Define your
            instructions, tools, and workflows in files you can edit, share, and
            version alongside your work.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/docs/start/first-agent/"
              >Build your first agent <span aria-hidden="true">↗</span></a
            ><a class="text-link" href="/docs/applications/"
              >See what you can build <span aria-hidden="true">→</span></a
            >
          </div>
          <p class="hero-note">
            No OCaml required to write your first agent.
            <span>Start locally. Add hosting when you need it.</span>
          </p>
        </div>
        <div
          class="hero-workbench"
          aria-label="Static agent definition example"
        >
          <div class="code-window">
            <div class="window-bar">
              <span class="file-tab"
                ><span class="file-icon" aria-hidden="true">⌘</span> assistant.chatmd</span
              ><span class="file-language">ChatMD</span><button
                id="wrap-agent"
                type="button"
                aria-label="Wrap agent code"
                aria-pressed="true"
                hidden>Wrap</button
              ><button
                id="copy-agent"
                type="button"
                aria-label="Copy agent definition">Copy</button
              >
            </div>
            <div class="hero-code" data-wrap="true">
              <Code
                code={hero.code}
                lang="xml"
                theme="github-dark"
                tabindex="0"
              />
            </div>
            <div class="code-caption">
              <span class="little-dot"></span> A complete, read-oriented repository
              assistant
            </div>
          </div>
          <div class="launch-line">
            <span class="prompt" aria-hidden="true">❯</span><code
              >chat-tui --no-config --local -file assistant.chatmd</code
            ><span class="terminal-label">terminal</span>
          </div>
          <p class="launch-note">
            After <a href="/docs/start/installation/">installing Ochat</a>, save
            this file in your project and run it there.
            <span class="demo-label"
              >Static source example · no recorded model output.</span
            >
            <a href={sourceUrl('Readme.md')}>View example source ↗</a> ·
            <a
              href={`${repository}/blob/main/Readme.md#run-your-first-local-agent`}
              >README walkthrough ↗</a
            >
          </p>
        </div>
      </section>
      <div class="wrap featured-workflow"><WorkflowDemo home /></div>
      <section class="build-section wrap" aria-labelledby="build-title">
        <div class="section-intro">
          <p class="eyebrow">Build around your work</p>
          <h2 id="build-title">What would you like to get done?</h2>
          <p>Three ways to start. More applications when you’re ready.</p>
        </div>
        <div class="capability-grid">
          {
            capabilities.map((c) => (
              <article class="capability">
                <>
                  <span class="step">
                    <WorkflowIcon kind={c.category} />
                  </span>
                  <span class="tag">{c.category}</span>
                  <h3>{c.title}</h3>
                  <>
                    <p>{c.summary}</p>
                    <div class="mini-artifact">
                      <span>Illustrative outcome</span>
                      {c.preview.map((line) => (
                        <small>{line}</small>
                      ))}
                    </div>
                  </>
                  <a class="text-link" href={c.route}>
                    Explore this application <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </section>
      <section class="benefits-section wrap" aria-labelledby="benefits-title">
        <div class="section-intro">
          <p class="eyebrow">Yours to shape</p><h2 id="benefits-title">
            Small definitions. Room to grow.
          </h2><p>
            Start with a useful prompt. Add the structure your workflow needs.
          </p>
        </div>
        <div class="benefits-grid">
          <article>
            <WorkflowIcon kind="Documentation" /><h3>
              Keep the workflow with the work.
            </h3><p>
              Review and share changes to an agent’s instructions and tools
              alongside your project.
            </p><a href="/docs/concepts/chatmd/">Understand ChatMD →</a>
          </article>
          <article>
            <WorkflowIcon /><h3>Give specialists a reusable role.</h3><p>
              Define a reviewer once. Call it from another agent, with its own
              instructions and selected tools.
            </p><a href="/docs/tutorials/specialist/">Connect two agents →</a>
          </article>
          <article>
            <WorkflowIcon kind="Automation" /><h3>
              Add control as you need it.
            </h3><p>
              Run a request from a script, react to events with ChatML, or let a
              daemon host own longer work.
            </p><a href="/docs/applications/background-workflow/"
              >Explore hosted workflows →</a
            >
          </article>
        </div>
      </section>
      <section class="closing wrap">
        <div>
          <p class="eyebrow">Keep exploring</p><h2>
            Make your first agent useful.
          </h2>
        </div><div>
          <a class="button primary" href="/docs/start/first-agent/"
            >Build your first agent <span aria-hidden="true">↗</span></a
          ><p>
            <a href="/docs/tutorials/">Tutorial curriculum</a> · <a
              href="/docs/applications/">All applications</a
            >
          </p>
        </div>
      </section>
    </main>
    <footer class="site-footer wrap">
      <a class="wordmark" href="/" aria-label="Ochat home"
        ><Mark /><span>ochat</span></a
      ><p>Your instructions. Your tools. Your workflow.</p><nav
        aria-label="Footer"
      >
        <a href="/docs/">Docs</a><a
          href={`${repository}/blob/main/Readme.md#documentation-and-contributing`}
          >Contribute ↗</a
        ><a href={repository}>GitHub ↗</a><a
          href={`${repository}/blob/main/LICENSE.txt`}>MIT license ↗</a
        >
      </nav>
    </footer>
    <div class="sr-only" role="status" id="copy-status"></div>
    <script is:inline define:vars={{ agentCode: hero.code }}>
      document
        .getElementById('copy-agent')
        ?.addEventListener('click', async () => {
          const button = document.getElementById('copy-agent');
          try {
            await navigator.clipboard.writeText(agentCode);
            button.textContent = 'Copied';
            document.getElementById('copy-status').textContent =
              'Agent definition copied';
            setTimeout(() => (button.textContent = 'Copy'), 1800);
          } catch {
            document.getElementById('copy-status').textContent =
              'Copy unavailable. Select and copy the code above.';
          }
        });
      const wrapButton = document.getElementById('wrap-agent');
      wrapButton.hidden = false;
      wrapButton.addEventListener('click', () => {
        const wrapped = wrapButton.getAttribute('aria-pressed') !== 'true';
        wrapButton.setAttribute('aria-pressed', String(wrapped));
        document.querySelector('.hero-code').dataset.wrap = String(wrapped);
      });
      const themeButton = document.getElementById('theme-toggle');
      const systemTheme = matchMedia('(prefers-color-scheme: dark)');
      let explicitTheme;
      try {
        const saved = localStorage.getItem('starlight-theme');
        if (saved === 'light' || saved === 'dark') explicitTheme = saved;
      } catch {}
      const applyTheme = () => {
        const dark = explicitTheme
          ? explicitTheme === 'dark'
          : systemTheme.matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        themeButton?.setAttribute('aria-pressed', String(dark));
        if (themeButton)
          themeButton.title = dark ? 'Use light theme' : 'Use dark theme';
      };
      applyTheme();
      systemTheme.addEventListener('change', applyTheme);
      themeButton?.addEventListener('click', () => {
        explicitTheme =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme();
        try {
          localStorage.setItem('starlight-theme', explicitTheme);
        } catch {}
      });
    </script>
  </body>
</html>
