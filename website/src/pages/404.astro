---
import Mark from '../components/Mark.astro';
import Search from '../components/Search.astro';
import ThemeProvider from '../components/ThemeProvider.astro';
import { repository } from '../../config/site.mjs';
import '../styles/home.css';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>Page not found — Ochat</title>
    <meta
      name="description"
      content="Find your way back to Ochat documentation, tutorials, and examples."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <ThemeProvider />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="error-header wrap">
      <a class="wordmark" href="/" aria-label="Ochat home"
        ><Mark /><span>ochat</span></a
      ><Search compact />
    </header>
    <main id="main" tabindex="-1" class="error-main wrap">
      <p class="eyebrow">404 · Page not found</p>
      <h1>Let’s get you<br />back to the docs.</h1>
      <p class="hero-description">
        This address doesn’t point to a page. Explore the documentation, look
        through the examples, or start with your first local agent.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/docs/">Explore documentation →</a><a
          class="text-link"
          href="/docs/start/first-agent/">Build your first agent ↗</a
        >
      </div>
      <nav class="error-links" aria-label="More places to start">
        <a href="/docs/examples/">Browse examples</a><a
          href={`${repository}/issues`}>Report a broken link ↗</a
        >
      </nav>
    </main>
  </body>
</html>
<style>
  .error-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .error-main {
    padding-block: clamp(3rem, 10vh, 7rem);
    max-width: 800px;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
    margin-top: 1.5rem;
  }
  .error-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
    color: var(--muted);
  }
  .error-links a {
    padding-block: 0.5rem;
    text-underline-offset: 0.2em;
  }
</style>
