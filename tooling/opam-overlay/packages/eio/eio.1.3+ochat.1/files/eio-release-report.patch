   val run_protected : ?name:string -> (t -> 'a) -> 'a
   (** [run_protected fn] is like [run] but ignores cancellation requests from the parent context. *)
+
+  module Release_report : sig
+    type t
+    (** Immutable observations of the original switch's actual release phase.
+        Only Eio can create this report. It carries no resource-use permission. *)
+
+    type status = Not_entered | Incomplete | Complete
+
+    val status : t -> status
+    (** [Not_entered] means switch entry did not begin (e.g. the parent was
+        already cancelled). [Incomplete] means entry began but actual fiber
+        joining/release did not finish. [Complete] means all registered fibers
+        finished and the original queued release callbacks were all attempted.
+        [Complete] alone does not mean those callbacks succeeded. *)
+
+    val attempted : t -> int
+    (** Number of original queued release callback invocations attempted. *)
+
+    val failures : t -> (exn * Printexc.raw_backtrace) list
+    (** Every exception raised by those actual callback invocations, in execution
+        order, captured before [fail] and exception combination. Preserves the
+        exact exception object and its captured raw backtrace, including
+        [Cancel.Cancelled] and the same exception object raised more than once.
+        An incomplete report may contain only a prefix of the observations.
+        Late [on_release] calls that execute immediately in the registering
+        caller after the hook queue closes are outside this terminal report;
+        they retain their existing direct exception behavior. *)
+  end
+
+  module Outcome : sig
+    type 'a t
+    val result : 'a t -> ('a, exn * Printexc.raw_backtrace) result
+    (** Exact value or aggregate exception/backtrace that [run] would return or
+        raise. This is not a separate callback-primary or cleanup result. *)
+
+    val release : 'a t -> Release_report.t
+  end
+
+  val run_reported : ?name:string -> (t -> 'a) -> 'a Outcome.t
+  (** Runs the same single switch as [run], with the same callback evaluation,
+      child cancellation, fiber joining, hook protection/order and exception
+      aggregation. Returns the terminal outcome as data instead of re-raising
+      its exception. No additional switch, fiber or user report callback runs.
+      Original [run] and [run_protected] behavior is unchanged.
+
+      The independent release report records actual hook failures before lossy
+      aggregation, even if [fn] or a child raised the same exception object, or
+      normal cancellation otherwise suppresses that release exception. It does
+      not classify callback/child errors as hook failures, or certify that a
+      resource was freed by a hook that raised. Complete with no failures proves
+      only that all original switch fibers joined and queued hooks returned. *)
 
