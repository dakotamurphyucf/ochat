+module Release_report = struct
+  type status = Not_entered | Incomplete | Complete
+
+  type t = {
+    status : status;
+    attempted : int;
+    failures : (exn * Printexc.raw_backtrace) list;
+  }
+
+  type capture = {
+    mutable entered : bool;
+    mutable complete : bool;
+    mutable attempted_count : int;
+    mutable failures_rev : (exn * Printexc.raw_backtrace) list;
+  }
+
+  let status t = t.status
+  let attempted t = t.attempted
+  let failures t = t.failures
+
+  let create_capture () =
+    { entered = false; complete = false; attempted_count = 0; failures_rev = [] }
+
+  let snapshot t = {
+    status = if not t.entered then Not_entered else if t.complete then Complete else Incomplete;
+    attempted = t.attempted_count;
+    failures = List.rev t.failures_rev;
+  }
+end
+
+module Outcome = struct
+  type 'a t = {
+    result : ('a, exn * Printexc.raw_backtrace) result;
+    release : Release_report.t;
+  }
+
+  let result t = t.result
+  let release t = t.release
+end
