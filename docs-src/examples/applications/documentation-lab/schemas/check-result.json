      "items": {
        "type": "object",
        "properties": {
          "tutorial_id": {"type": "string", "enum": ["passing", "broken"]},
          "status": {"type": "string", "enum": ["passed", "failed"]},
          "exit_code": {"type": "integer", "enum": [0, 1]},
          "evidence_path": {"type": "string"},
          "summary": {"type": "string"}
        },
        "required": ["tutorial_id", "status", "exit_code", "evidence_path", "summary"],
        "additionalProperties": false
      }
    }
