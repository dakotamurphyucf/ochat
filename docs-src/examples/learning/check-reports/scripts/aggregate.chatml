(* Checked_json is a source module selected by this declaration's project.
   Decode the complete request before constructing any file tasks. *)
let decode_files input = Checked_json.array(input, Checked_json.string)

let decode_check input =
  Outcome.bind(Checked_json.field(input, "check", Checked_json.string), fun check ->
    Outcome.map(Checked_json.field(input, "status", fun value ->
      Checked_json.validate(Checked_json.string(value),
        "A check status must be passed or failed.",
        fun status -> Array.exists(["passed", "failed"], fun expected -> status == expected))),
      fun status -> {check = check; status = status}))

let decode_report input = Checked_json.array(input, decode_check)

(* read_file prefixes complete text with two metadata lines. A missing line is
   a protocol failure, not an empty report or a successful partial summary. *)
let after_line text =
  match String.find(text, "\n") with
  | `Some(index) ->
      `Ok(String.slice(text, index + 1, String.length(text) - index - 1))
  | `None -> `Error("Expected a complete read_file response.")

let read_report filename =
  let* result = Tool.call("read_file", `Object([
    {key = "root"; value = `String("reports")},
    {key = "file"; value = `String(filename)}
  ])) in
  match result with
  | `Error(message) -> Task.fail(message)
  | `Ok(`String(text)) ->
      (match Outcome.bind(after_line(text), after_line) with
      | `Error(message) -> Task.fail(message)
      | `Ok(body) ->
          (match Outcome.bind(Checked_json.parse(body), decode_report) with
          | `Error(error) -> Task.fail(Checked_json.describe(error))
          | `Ok(checks) -> Task.pure(checks)))
  | `Ok(_) -> Task.fail("The file tool returned a non-text result.")

let add_report totals checks =
  Array.iter(checks, fun item ->
    if item.status == "failed" then
      let previous = Option.get_or(Hashtbl.get(totals, item.check), 0.0) in
      Hashtbl.set(totals, item.check, previous +. 1.0)
    else ())

let summarize files =
  let totals = Hashtbl.create() in
  let* ignored = Task.iter_array(files, fun filename ->
    let* checks = read_report(filename) in
    let ignored = add_report(totals, checks) in
    Task.pure(())) in
  (* Snapshot order is first insertion of a failing check. The local table is
     neither persistent workflow state nor shared with another invocation. *)
  Task.pure(`Array(Array.map(Hashtbl.to_array(totals), fun entry -> `Object([
    {key = "check"; value = `String(entry.key)},
    {key = "failures"; value = `Number(entry.value)}
  ]))))

let main input =
  match decode_files(input) with
  | `Error(error) -> Task.fail(Checked_json.describe(error))
  | `Ok(files) -> summarize(files)

let run ctx input =
  match Outcome.bind(Checked_json.object_fields(input, ["files"]), fun object ->
    Checked_json.field(object, "files", decode_files)) with
  | `Error(error) -> Task.fail(Checked_json.describe(error))
  | `Ok(files) ->
      let* summary = summarize(files) in
      Task.pure(`Complete(summary))
