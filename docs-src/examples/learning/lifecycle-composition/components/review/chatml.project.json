{
  "schema_version": 1,
  "namespace": "ochat.examples.lifecycle-composition.review",
  "dependencies": {
    "lifecycle": {
      "source": {
        "kind": "local",
        "path": "../../../../libraries/lifecycle"
      },
      "project": "chatml.project.json",
      "environment": "pure"
    }
  },
  "modules": {
    "Review": {
      "implementation": "src/review.chatml",
      "interface": "src/review.chatmli"
    }
  },
  "environments": {
    "default": {
      "modules": {
        "Review": "self.Review",
        "Lifecycle": "lifecycle.Lifecycle"
      },
      "requires": {
        "targets": [
          "moderator_v1",
          "delegated_moderator_v1"
        ]
      }
    }
  }
}
